# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Explicitly declare text files
*.rs text eol=lf
*.toml text eol=lf
*.dart text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.md text eol=lf
*.json text eol=lf
*.sh text eol=lf

# Windows scripts require CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wasm binary
*.gguf binary
*.safetensors binary
*.onnx binary

